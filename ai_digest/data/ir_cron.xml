<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_channel_bot" model="ir.cron">
        <field name="name">AI Digest: Discuss channel bot</field>
        <field name="model_id" ref="model_ai_digest"/>
        <field name="state">code</field>
        <field name="code">model._cron_channel_bot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_daily_digest" model="ir.cron">
        <field name="name">AI Digest: daily summary to Discuss channel</field>
        <field name="model_id" ref="model_ai_digest"/>
        <field name="state">code</field>
        <field name="code">model._run_daily_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
